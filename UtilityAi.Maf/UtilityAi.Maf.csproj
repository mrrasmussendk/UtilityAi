<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>UtilityAi.Maf</RootNamespace>

        <!-- NuGet metadata -->
        <PackageId>UtilityAi.Maf</PackageId>
        <Version>1.0.0</Version>
        <Title>UtilityAI Framework - Microsoft Agent Framework Integration</Title>
        <Description>Integration layer between UtilityAI orchestration framework and Microsoft Agent Framework (MAF). Enables utility-based decision-making to select and orchestrate MAF agents.</Description>
        <Authors>Marc Rasmussen</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mrrasmussendk/UtilityAi</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/mrrasmussendk/UtilityAi</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>utility-ai;ai;agent;orchestration;maf;microsoft-agent-framework;dotnet;csharp</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Build determinism & source info -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\UtilityAi\UtilityAi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.0.0-preview.260212.1" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

    <PropertyGroup>
        <NoWarn>1591;1572;1573;1734</NoWarn>
    </PropertyGroup>

</Project>
