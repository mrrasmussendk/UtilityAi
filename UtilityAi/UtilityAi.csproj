<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet metadata -->
        <PackageId>UtilityAi</PackageId>
        <Version>1.1.4</Version>
        <Title>UtilityAI Framework - AI Agent Orchestration</Title>
        <Description>Lightweight framework for building AI agent orchestration systems using Utility AI patterns. Features event history, subscriptions, scoped state for multi-agent coordination, and comprehensive documentation.</Description>
        <Authors>Marc Rasmussen</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mrrasmussendk/UtilityAi</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/mrrasmussendk/UtilityAi</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>utility-ai;ai;agent;orchestration;decision-making;llm;multi-agent;ai-framework;dotnet;csharp</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Build determinism & source info -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Symbols (optional but recommended). If you enable, also push the .snupkg -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <!-- README & icon must be included -->
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- Add SourceLink to improve debugging experience for consumers -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

  <PropertyGroup>
    <!-- Suppress XML doc warnings and related doc-comment mismatches for public API -->
    <NoWarn>1591;1572;1573;1734</NoWarn>
  </PropertyGroup>
</Project>
